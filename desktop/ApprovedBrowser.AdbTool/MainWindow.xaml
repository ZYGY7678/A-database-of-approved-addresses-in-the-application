<Window x:Class="ApprovedBrowser.AdbTool.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="דפדפן מאושר — כלי ניהול ADB" Width="980" Height="700" MinWidth="860" MinHeight="620" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}" FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextBrush}">
<Grid Margin="34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Grid.Row="0" Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="דפדפן מאושר" FontSize="31" FontWeight="Bold"/><TextBlock Text="מרכז ניהול והגנת המכשיר" Margin="0,5,0,0" FontSize="16" Foreground="{StaticResource MutedBrush}"/></StackPanel>
<Border Grid.Column="1" Width="76" Height="76" CornerRadius="19" Background="#0A1A3B" BorderBrush="#2476D9" BorderThickness="1.5" Padding="7"><Grid>
<Ellipse Fill="#083B9A" Stroke="#1677FF" StrokeThickness="1.5"/><Ellipse Width="50" Height="50" Stroke="#18E0F2" StrokeThickness="1" Opacity=".7"/>
<Path Stroke="#18E0F2" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,49 C18,37 27,32 38,32 C49,32 58,27 72,16"/>
<Path Stroke="#1677FF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,27 C18,39 27,49 38,49 C49,49 58,58 72,69"/>
<Border Width="31" Height="27" Background="#F4F8FF" CornerRadius="6" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,11,0,0"><Grid><Path Stroke="#DDEBFF" StrokeThickness="4" Fill="Transparent" Data="M7,11 C7,2 24,2 24,11"/><Ellipse Width="5" Height="5" Fill="#06122D" VerticalAlignment="Center"/></Grid></Border>
</Grid></Border></Grid>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
<Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="חיבור למכשיר" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="DeviceStatusText" Text="בודק חיבור ADB..." Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" FontSize="14"/></StackPanel><Border Grid.Column="1" Padding="14,8" CornerRadius="14" Background="#0A3C5C"><TextBlock x:Name="ConnectionBadge" Text="בודק..." FontWeight="SemiBold" Foreground="#76F5FF"/></Border></Grid></Border>
<Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="מסלולי הגנה" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="הגדרות המסלול מנוהלות מתוך אפליקציית דפדפן מאושר" Margin="0,7,0,16" Foreground="{StaticResource MutedBrush}"/><StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"><Border Background="#0E3B62" CornerRadius="13" Padding="18,10" Margin="0,0,10,0"><TextBlock Text="אתרוג" FontWeight="SemiBold"/></Border><Border Background="#123D55" CornerRadius="13" Padding="18,10" Margin="0,0,10,0"><TextBlock Text="הדס" FontWeight="SemiBold"/></Border><Border Background="#123E4C" CornerRadius="13" Padding="18,10"><TextBlock Text="לולב" FontWeight="SemiBold"/></Border></StackPanel></StackPanel></Border>
<Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="הגנת המכשיר" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="הפעולה הבאה שולחת למכשיר את פקודת ADB להגדרת האפליקציה כבעלת המכשיר" Margin="0,7,0,18" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><Button x:Name="SetOwnerButton" Content="הגדר בעל מכשיר" Style="{StaticResource PrimaryButton}" Click="SetOwnerButton_Click" HorizontalAlignment="Right" MinWidth="190"/><TextBlock Text="הפקודה שנשלחת" Margin="0,20,0,6" Foreground="{StaticResource MutedBrush}"/><Border Background="#071632" BorderBrush="#1C3966" BorderThickness="1" CornerRadius="12" Padding="14"><TextBlock Text="adb shell dpm set-device-owner com.zygy7678.approvedbrowser/.ApprovedBrowserDeviceAdminReceiver" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" FlowDirection="LeftToRight"/></Border></StackPanel></Border>
<Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="יומן פעולות" FontSize="21" FontWeight="SemiBold"/><Border Background="#071632" BorderBrush="#1C3966" BorderThickness="1" CornerRadius="12" Margin="0,12,0,0" Padding="12"><TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#CFE4FF" FontFamily="Consolas" FontSize="12" MinHeight="110" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Border></StackPanel></Border>
</StackPanel></ScrollViewer>
<Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="דפדפן מאושר • כלי ADB" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="בדוק חיבור מחדש" Style="{StaticResource SecondaryButton}" Click="RefreshButton_Click" Padding="18,9"/></Grid>
</Grid></Window>