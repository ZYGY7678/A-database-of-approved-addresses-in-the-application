<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ApprovedBrowser.AdbTool</AssemblyName>
    <RootNamespace>ApprovedBrowser.AdbTool</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\ApprovedBrowser.apk" LogicalName="ApprovedBrowser.Apk" />
  </ItemGroup>
</Project>