<Application x:Class="ApprovedBrowser.AdbTool.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
<Application.Resources>
<FontFamily x:Key="AppFont">Segoe UI</FontFamily>
<LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#06122D" Offset="0"/><GradientStop Color="#0B1E4A" Offset=".55"/><GradientStop Color="#06122D" Offset="1"/></LinearGradientBrush>
<LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#18E0F2" Offset="0"/><GradientStop Color="#1677FF" Offset="1"/></LinearGradientBrush>
<SolidColorBrush x:Key="CardBrush" Color="#102653"/><SolidColorBrush x:Key="CardBorderBrush" Color="#244A83"/><SolidColorBrush x:Key="MutedBrush" Color="#A9C2E8"/><SolidColorBrush x:Key="TextBrush" Color="#F4F8FF"/>
<Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
<Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="22,12"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="{StaticResource AccentGradient}"/><Setter Property="Cursor" Value="Hand"/></Style>
<Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="#173665"/><Setter Property="BorderBrush" Value="#2A5B98"/><Setter Property="BorderThickness" Value="1"/></Style>
</Application.Resources></Application>